{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.2.0",
  "identifier": "local.agentdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentDeck",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#111318"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": ["icons/icon.png"],
    "linux": {
      "deb": {
        "depends": ["curl"]
      }
    },
    "category": "Development",
    "shortDescription": "A local chat interface for Claude Code CLI"
  }
}
